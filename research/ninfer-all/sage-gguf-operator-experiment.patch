+float exact_iq4_xs(const std::uint8_t* b, int element) {
+    constexpr int values[16] = {-127, -104, -83, -65, -49, -35, -22, -10,
+                                 1, 13, 25, 38, 53, 69, 89, 113};
+    const std::uint16_t bits = std::uint16_t(b[0]) | (std::uint16_t(b[1]) << 8);
+    const int exponent = (bits >> 10) & 31, fraction = bits & 1023;
+    if (exponent == 31) { throw std::runtime_error("nonfinite IQ4_XS scale"); }
+    const double magnitude = exponent ? std::ldexp(1024.0 + fraction, exponent - 25)
+                                      : std::ldexp(double(fraction), -24);
+    const double d = bits & 0x8000 ? -magnitude : magnitude;
+    const int sub = element / 32, index = element % 32;
+    const unsigned high = unsigned(b[2]) | (unsigned(b[3]) << 8);
+    const unsigned low = (b[4 + sub / 2] >> (4 * (sub % 2))) & 15;
+    const int scale = int(low | (((high >> (2 * sub)) & 3) << 4)) - 32;
+    const unsigned packed = b[8 + 16 * sub + index % 16];
+    const unsigned code = index < 16 ? packed & 15 : packed >> 4;
+    return float(d * scale * values[code]);
+}
+
+double exact_half_word(const std::uint8_t* b) {
+    const unsigned bits = unsigned(b[0]) | (unsigned(b[1]) << 8);
+    const int exponent = (bits >> 10) & 31, fraction = bits & 1023;
+    if (exponent == 31) { throw std::runtime_error("nonfinite scale in fixture"); }
+    const double magnitude = exponent ? std::ldexp(1024.0 + fraction, exponent - 25)
