+# Sage GGUF MoE operator qualification; this never builds the model runtime.
+cmake_minimum_required(VERSION 3.28)
+project(sage_moe_compile_probe LANGUAGES CXX CUDA)
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CUDA_STANDARD 20)
+set(CMAKE_CUDA_ARCHITECTURES 75)
+find_package(CUDAToolkit REQUIRED)
+get_filename_component(NINFER_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
+add_library(sage_moe_probe OBJECT "${NINFER_SOURCE}/src/ops/moe_experts/moe_experts_sage_experimental.cu")
+target_include_directories(sage_moe_probe PRIVATE "${NINFER_SOURCE}/include" "${NINFER_SOURCE}/src")
+target_compile_definitions(sage_moe_probe PRIVATE NINFER_SM8X_COMPAT=1)
+target_link_libraries(sage_moe_probe PRIVATE CUDA::cudart)
+add_library(sage_moe_oracle_probe OBJECT "${NINFER_SOURCE}/tests/ops/test_moe_experts_sage_experimental.cpp")
+set_source_files_properties("${NINFER_SOURCE}/tests/ops/test_moe_experts_sage_experimental.cpp"
+  PROPERTIES OBJECT_DEPENDS "${NINFER_SOURCE}/tests/ops/test_moe_experts_gguf.cpp")
+target_include_directories(sage_moe_oracle_probe PRIVATE "${NINFER_SOURCE}/include" "${NINFER_SOURCE}/src")
+target_compile_definitions(sage_moe_oracle_probe PRIVATE NINFER_SM8X_COMPAT=1)
+target_link_libraries(sage_moe_oracle_probe PRIVATE CUDA::cudart)
+
+# Optional link-only path. This uses NInfer's existing core/ops archives and
+# bundled ggml bridge directly; it does not configure media, FFmpeg or serving.
+# The archives are sizeable: request this target explicitly and build with -j1.
+option(SAGE_LINK_ORACLE "Build the experimental standalone CUDA oracle" OFF)
+if(SAGE_LINK_ORACLE)
+  find_package(Threads REQUIRED)
+  set(PROJECT_SOURCE_DIR "${NINFER_SOURCE}")
+  set(NINFER_COMPAT_PATH ON)
+  set(NINFER_ARCH_TURING ON)
+  set(NINFER_ARCH_BLACKWELL OFF)
+  set(NINFER_WINDOWS_KERNEL_DLL OFF)
+  set(NINFER_DIRECTSTORAGE OFF)
+  set(NINFER_CUDART_TARGET CUDA::cudart_static)
+  add_compile_definitions(NINFER_SM8X_COMPAT=1)
+  include("${NINFER_SOURCE}/cmake/NinferTargets.cmake")
+  add_subdirectory("${NINFER_SOURCE}/src/core" "${CMAKE_BINARY_DIR}/ninfer-core")
+  add_subdirectory("${NINFER_SOURCE}/src/ops" "${CMAKE_BINARY_DIR}/ninfer-ops")
+  add_executable(sage_moe_oracle $<TARGET_OBJECTS:sage_moe_probe> $<TARGET_OBJECTS:sage_moe_oracle_probe>)
+  set_target_properties(sage_moe_oracle PROPERTIES LINKER_LANGUAGE CUDA)
+  target_link_libraries(sage_moe_oracle PRIVATE ninfer_ops ninfer_core CUDA::cublas CUDA::cuda_driver CUDA::cudart_static)
+endif()
+# Regression compile of the unchanged Flash-Next entry points after extracting
+# the shared staged implementation. Object-only; this does not execute CUDA.
+add_library(flash_moe_regression_probe OBJECT "${NINFER_SOURCE}/src/ops/moe_experts/moe_experts_gguf.cu")
+target_include_directories(flash_moe_regression_probe PRIVATE "${NINFER_SOURCE}/include" "${NINFER_SOURCE}/src")
+target_compile_definitions(flash_moe_regression_probe PRIVATE NINFER_SM8X_COMPAT=1)
+target_link_libraries(flash_moe_regression_probe PRIVATE CUDA::cudart)
+
+# Minimal direct-source link experiment: only GGUF bridges, core objects and
+# Sage qualification. No media libraries or production engine/serving.
+option(SAGE_LINK_MINIMAL "Build Sage oracle using only direct dependencies" OFF)
+if(SAGE_LINK_MINIMAL)
+  file(GLOB SAGE_GGML_MATRIX "${NINFER_SOURCE}/src/ops/linear/gguf/ggml_mmq_*.cu")
+  file(GLOB SAGE_GGML_VECTOR "${NINFER_SOURCE}/src/ops/linear/gguf/ggml_vec_*.cu")
+  add_executable(sage_moe_minimal
+    $<TARGET_OBJECTS:sage_moe_probe> $<TARGET_OBJECTS:sage_moe_oracle_probe>
+    "${NINFER_SOURCE}/src/core/arena.cu"
+    "${NINFER_SOURCE}/src/core/device.cu"
+    "${NINFER_SOURCE}/src/core/device_launch.cpp"
+    "${NINFER_SOURCE}/src/core/peer_preflight.cpp"
+    "${NINFER_SOURCE}/src/core/tensor.cpp"
+    "${NINFER_SOURCE}/src/core/layout.cpp"
+    "${NINFER_SOURCE}/src/core/dtype.cpp"
+    "${NINFER_SOURCE}/src/core/weight_view.cpp"
+    "${NINFER_SOURCE}/src/ops/common/device_route.cpp"
+    "${NINFER_SOURCE}/src/ops/common/device_tier.cu"
+    "${NINFER_SOURCE}/src/ops/linear/gguf/ggml_bridge.cu"
+    "${NINFER_SOURCE}/src/ops/linear/gguf/gguf_linear.cpp"
+    "${NINFER_SOURCE}/src/ops/linear/sm70/sm70_gemm.cu"
+    ${SAGE_GGML_MATRIX} ${SAGE_GGML_VECTOR})
+  target_include_directories(sage_moe_minimal PRIVATE "${NINFER_SOURCE}/include" "${NINFER_SOURCE}/src"
+    "${NINFER_SOURCE}/third_party/ggml-quants/include" "${NINFER_SOURCE}/third_party/ggml-quants/src")
+  target_compile_definitions(sage_moe_minimal PRIVATE NINFER_SM8X_COMPAT=1 NINFER_TIER_TURING=1 NINFER_CUDA_ARCHITECTURES="75")
+  target_compile_options(sage_moe_minimal PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda>)
+  target_link_libraries(sage_moe_minimal PRIVATE CUDA::cublas CUDA::cuda_driver CUDA::cudart_static delayimp)
+  target_link_options(sage_moe_minimal PRIVATE "$<HOST_LINK:/DELAYLOAD:nvcuda.dll>")
+  set_target_properties(sage_moe_minimal PROPERTIES LINKER_LANGUAGE CUDA CUDA_RUNTIME_LIBRARY Static)
+endif()
