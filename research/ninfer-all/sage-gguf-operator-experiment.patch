+// Experimental Sage-shaped GGUF MoE. Shares the Flash-Next staged kernels,
+// but never calls its 2560/640-specific fused decode bridge.
+#include "ninfer/ops/moe_experts_sage_experimental.h"
+#include "core/device.h"
+#include "core/layout.h"
+#include "ops/common/fixed_point.cuh"
+#include "ops/common/silu.h"
+#include "ops/linear/gguf/gguf_linear.h"
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+namespace ninfer::ops {
+namespace sage_gguf_detail {
+constexpr int kHidden = 2048, kWidth = 512, kExperts = 256, kTopK = 8;
+constexpr int kVectorTokens = 8;
+#include "moe_experts_gguf_staged.cuh"
+}
+namespace sage {
+using namespace sage_gguf_detail;
+
+std::size_t workspace_bytes(std::int32_t tokens) {
+    require(tokens > 0 && tokens <= 65535 / kTopK, "invalid token count");
+    const std::int32_t pairs = tokens * kTopK;
+    WorkspaceLayoutBuilder layout;
+    (void)layout.alloc(DType::U8, {static_cast<std::int32_t>(gguf::vector_activation_bytes(kHidden, tokens))});
+    (void)layout.alloc(DType::I64, {kHidden, tokens});
+    (void)layout.alloc(DType::I32, {tokens});
+    (void)layout.alloc(DType::U8, {static_cast<std::int32_t>(gguf::moe_routing_bytes(kExperts, pairs))});
+    (void)layout.alloc(DType::BF16, {kWidth, pairs});
+    {
+        auto planes = layout.scope();
+        if (tokens > kVectorTokens) {
+            const auto bytes = static_cast<std::int32_t>(gguf::moe_matrix_activation_bytes(kHidden, pairs));
+            (void)layout.alloc(DType::U8, {bytes});
+            (void)layout.alloc(DType::U8, {bytes});
+            (void)layout.alloc(DType::FP32, {kWidth, pairs});
+        }
+        (void)layout.alloc(DType::FP32, {kWidth, pairs});
+    }
+    (void)layout.alloc(DType::U8, {static_cast<std::int32_t>(gguf::vector_activation_bytes(kWidth, pairs))});
+    if (tokens > kVectorTokens) {
+        (void)layout.alloc(DType::U8, {static_cast<std::int32_t>(gguf::moe_matrix_activation_bytes(kWidth, pairs))});
+        (void)layout.alloc(DType::FP32, {kHidden, pairs});
+    }
+    return layout.peak_bytes(1);
+}
+
+void experts(const Tensor& m, const Tensor& ids, const Tensor& weights,
+             const Tensor& shared, const GgufMoeWeights& banks,
+             WorkspaceArena& workspace, Tensor& y, cudaStream_t stream) {
+    const std::int32_t tokens = m.ne[1];
+    require(tokens > 0 && tokens <= 65535 / kTopK, "invalid token count");
+    require(shaped(m, DType::BF16, kHidden, tokens), "m must be BF16 [2048,T]");
+    require(shaped(ids, DType::I32, kTopK, tokens), "ids must be I32 [8,T]");
+    require(shaped(weights, DType::FP32, kTopK, tokens), "weights must be FP32 [8,T]");
+    require(shaped(y, DType::FP32, kHidden, tokens), "y must be FP32 [2048,T]");
+    require(shared.dtype == DType::FP32 && shared.is_contiguous() && shared.data &&
+            shared.numel() == tokens, "shared must be FP32 [T]");
+    require(banks.experts == kExperts, "Sage requires 256 expert table entries");
+    auto outer = workspace.scope();
+    Tensor activation = workspace.alloc(DType::U8, {static_cast<std::int32_t>(gguf::vector_activation_bytes(kHidden, tokens))});
+    gguf::quantize_vector_activation(static_cast<const __nv_bfloat16*>(m.data), kHidden,
+                                     tokens, nullptr, activation.data, stream);
+    Tensor fixed = workspace.alloc(DType::I64, {kHidden, tokens});
+    CUDA_CHECK(cudaMemsetAsync(fixed.data, 0, fixed.bytes(), stream));
+    auto* sums = static_cast<unsigned long long*>(fixed.data);
+    const auto* input = static_cast<const __nv_bfloat16*>(m.data);
+    run_bank(ids, tokens * kTopK, kExperts, kTopK, static_cast<const float*>(weights.data),
+             input, activation.data, tokens, banks.gate, banks.up, banks.down,
+             banks.device_resident, workspace, sums, stream);
+    {
+        auto scope = workspace.scope();
+        Tensor shared_ids = workspace.alloc(DType::I32, {tokens});
+        CUDA_CHECK(cudaMemsetAsync(shared_ids.data, 0, shared_ids.bytes(), stream));
+        run_bank(shared_ids, tokens, 1, 1, static_cast<const float*>(shared.data),
+                 input, activation.data, tokens, banks.shared_gate, banks.shared_up,
+                 banks.shared_down, banks.device_resident, workspace, sums, stream);
+    }
+    const std::int64_t count = std::int64_t(kHidden) * tokens;
+    store_fixed_kernel<<<static_cast<unsigned>((count + 255) / 256), 256, 0, stream>>>(
+        sums, static_cast<float*>(y.data), count);
+    CUDA_CHECK(cudaGetLastError());
+}
+} // namespace sage
+} // namespace ninfer::ops
