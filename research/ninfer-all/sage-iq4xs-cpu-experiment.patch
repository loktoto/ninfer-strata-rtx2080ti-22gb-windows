+class SageExpertMathTest(unittest.TestCase):
+    def test_expert_and_weighted_shared_against_scalar_math(self):
+        import math
+        from tools.convert.sage_iq4xs_oracle import expert_product, routed_sum
+        x = np.array([2.0, -1.0]); gate = np.array([[1., 0.], [0., 1.]])
+        up = np.array([[0.5, 1.], [-2., 0.]])
+        down = np.array([[1., 2.], [-1., 0.5]])
+        expit = lambda v: 1 / (1 + math.exp(-v))
+        m0 = (2 * expit(2)) * 0
+        m1 = (-1 * expit(-1)) * -4
+        expected = np.array([m0 + 2*m1, -m0 + .5*m1])
+        np.testing.assert_allclose(expert_product(x, gate, up, down), expected, rtol=1e-15)
+        result = routed_sum(x, {7:(gate,up,down)}, [7], [0.25], (gate,up,down), 0.75)
+        np.testing.assert_allclose(result, expected, rtol=1e-15)
+    def test_rejects_invalid_shapes_and_empty_routes(self):
+        from tools.convert.sage_iq4xs_oracle import expert_product, routed_sum
+        with self.assertRaises(ValueError): expert_product([1], [[1,2]], [[1,2]], [[1]])
+        with self.assertRaises(ValueError): routed_sum([1], {}, [], [], None, 1)
