+++ b/tests/convert/test_sage_iq4xs_oracle.py
@@ -0,0 +1,53 @@
+import unittest
+import numpy as np
+from gguf import GGMLQuantizationType
+from gguf.quants import dequantize
+from tools.convert.sage_iq4xs_oracle import decode_iq4_xs
+
+class SageIQ4XSOracleTest(unittest.TestCase):
+    def test_against_gguf_with_adversarial_codes_and_scales(self):
+        rng = np.random.default_rng(7841)
+        blocks = rng.integers(0, 256, size=(7, 5, 136), dtype=np.uint8)
+        scales = np.array([0, 1, -1, .0625, -0.5, 100, 0.00006103515625],dtype='<f2')
+        blocks[:, :, :2] = scales[:, None, None].view(np.uint8).reshape(7, 1, 2)
+        raw = blocks.reshape(7,-1)
+        expected = dequantize(raw, GGMLQuantizationType.IQ4_XS)
+        np.testing.assert_array_equal(decode_iq4_xs(raw), expected.astype(np.float64))
+    def test_rejects_partial_blocks(self):
+        for x in (np.zeros((2,135),np.uint8),np.zeros((0,),np.uint8),np.zeros((1,0),np.uint8)):
+            with self.assertRaises(ValueError): decode_iq4_xs(x)
+
+    def test_optional_real_expert_blocks(self):
+        import os
+        from tools.convert.sources.gguf import GGUFFile
+        from tools.convert.sage_gguf_experts import expert_sources
+        model = os.environ.get('NINFER_TEST_SAGE_GGUF')
+        if not model: self.skipTest('set NINFER_TEST_SAGE_GGUF for real weights')
+        with GGUFFile(model) as gguf:
+            for layer in (0, 19, 39):
+                for expert in (0, 127, 255):
+                    for role, source in expert_sources(gguf, layer, expert).items():
+                        count = 2048 if role == 'down' else 512
+                        for row in (0,count-1):
+                            blocks = source.read_encoded(row,row+1).codes.numpy()
+                            expected = dequantize(blocks, GGMLQuantizationType.IQ4_XS)
+                            np.testing.assert_array_equal(decode_iq4_xs(blocks), expected.astype(np.float64))
+
+class SageExpertMathTest(unittest.TestCase):
+    def test_expert_and_weighted_shared_against_scalar_math(self):
+        import math
+        from tools.convert.sage_iq4xs_oracle import expert_product, routed_sum
+        x = np.array([2.0, -1.0]); gate = np.array([[1., 0.], [0., 1.]])
+        up = np.array([[0.5, 1.], [-2., 0.]])
+        down = np.array([[1., 2.], [-1., 0.5]])
+        expit = lambda v: 1 / (1 + math.exp(-v))
+        m0 = (2 * expit(2)) * 0
+        m1 = (-1 * expit(-1)) * -4
+        expected = np.array([m0 + 2*m1, -m0 + .5*m1])
+        np.testing.assert_allclose(expert_product(x, gate, up, down), expected, rtol=1e-15)
+        result = routed_sum(x, {7:(gate,up,down)}, [7], [0.25], (gate,up,down), 0.75)
+        np.testing.assert_allclose(result, expected, rtol=1e-15)
+    def test_rejects_invalid_shapes_and_empty_routes(self):
+        from tools.convert.sage_iq4xs_oracle import expert_product, routed_sum
+        with self.assertRaises(ValueError): expert_product([1], [[1,2]], [[1,2]], [[1]])
+        with self.assertRaises(ValueError): routed_sum([1], {}, [], [], None, 1)
