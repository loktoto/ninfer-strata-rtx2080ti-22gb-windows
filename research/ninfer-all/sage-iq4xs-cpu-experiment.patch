+import unittest
+import numpy as np
+from gguf import GGMLQuantizationType
+from gguf.quants import dequantize
+from tools.convert.sage_iq4xs_oracle import decode_iq4_xs
+
+class SageIQ4XSOracleTest(unittest.TestCase):
+    def test_against_gguf_with_adversarial_codes_and_scales(self):
+        rng = np.random.default_rng(7841)
+        blocks = rng.integers(0, 256, size=(7, 5, 136), dtype=np.uint8)
+        scales = np.array([0, 1, -1, .0625, -0.5, 100, 0.00006103515625],dtype='<f2')
+        blocks[:, :, :2] = scales[:, None, None].view(np.uint8).reshape(7, 1, 2)
+        raw = blocks.reshape(7,-1)
+        expected = dequantize(raw, GGMLQuantizationType.IQ4_XS)
+        np.testing.assert_array_equal(decode_iq4_xs(raw), expected.astype(np.float64))
+    def test_rejects_partial_blocks(self):
+        for x in (np.zeros((2,135),np.uint8),np.zeros((0,),np.uint8),np.zeros((1,0),np.uint8)):
+            with self.assertRaises(ValueError): decode_iq4_xs(x)
+
+    def test_optional_real_expert_blocks(self):
