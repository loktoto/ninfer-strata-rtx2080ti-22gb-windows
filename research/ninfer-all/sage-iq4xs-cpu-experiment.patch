+        with GGUFFile(model) as gguf:
+            for layer in (0, 19, 39):
+                for expert in (0, 127, 255):
+                    for role, source in expert_sources(gguf, layer, expert).items():
+                        count = 2048 if role == 'down' else 512
+                        for row in (0,count-1):
+                            blocks = source.read_encoded(row,row+1).codes.numpy()
+                            expected = dequantize(blocks, GGMLQuantizationType.IQ4_XS)
+                            np.testing.assert_array_equal(decode_iq4_xs(blocks), expected.astype(np.float64))
