+// Optional audit of the engine's own slot metadata. This checks ownership and bounds,
+// not GPU completion: the existing stream barriers and events provide that ordering.
+void Engine::audit_cache(const char* where) const {
+    const char* enabled = std::getenv("STRATA_SAGE_AUDIT_CACHE");
+    if (!enabled || std::strcmp(enabled, "1") != 0) return;
+    const auto fail = [where](const char* reason) {
+        throw std::logic_error(std::string("expert cache audit at ") + where + ": " + reason);
+    };
+    struct Range { size_t begin, end; };
+    std::vector<Range> ranges;
+    const uintptr_t base = reinterpret_cast<uintptr_t>(exp_);
+    const auto add = [&](const uint8_t* slot, size_t bytes) {
+        const uintptr_t address = reinterpret_cast<uintptr_t>(slot);
+        if (!exp_ || address < base || address - base > exp_at_ ||
+            bytes > exp_at_ - (address - base)) fail("slot outside the allocated extent");
+        ranges.push_back({size_t(address - base), size_t(address - base) + bytes});
+    };
+    if (vmm_ && exp_ && exp_at_ && (exp_at_ > arena_.mapped || kTail > arena_.mapped - exp_at_))
+        fail("allocated extent exceeds mapped arena");
+    for (const Layer& layer : layers_)
+        for (const uint8_t* slot : layer.slot)
+            if (slot) add(slot, layer.slot_bytes);
+    std::vector<uint8_t> seen(coming_.size(), 0);
+    for (int j = 0; j < n_swap_; ++j) {
+        const Swap& s = swap_[(size_t) j];
+        const int state = s.at.load();
+        if (state == Swap::kFree) continue;
+        if (state != Swap::kAsked && state != Swap::kSent) fail("unknown upload state");
+        if (s.il < 0 || size_t(s.il) >= layers_.size() || s.e < 0 || s.e >= n_expert_)
+            fail("upload target is invalid");
+        const Layer& layer = layers_[(size_t) s.il];
+        const size_t i = size_t(s.il) * size_t(n_expert_) + size_t(s.e);
+        if (size_t(s.e) >= layer.slot.size() || i >= coming_.size() || !coming_[i] || seen[i] || layer.slot[(size_t) s.e])
+            fail("upload target ownership is inconsistent");
+        seen[i] = 1;
+        add(s.slot, layer.slot_bytes);
+    }
+    for (size_t i = 0; i < coming_.size(); ++i)
+        if (!!coming_[i] != !!seen[i]) fail("orphaned upload target");
+    std::sort(ranges.begin(), ranges.end(), [](const Range& a, const Range& b) { return a.begin < b.begin; });
+    for (size_t i = 1; i < ranges.size(); ++i)
+        if (ranges[i].begin < ranges[i - 1].end) fail("overlapping slot owners");
+    if (ranges.size() != size_t(cached_)) fail("cached count disagrees with slot owners");
+}
