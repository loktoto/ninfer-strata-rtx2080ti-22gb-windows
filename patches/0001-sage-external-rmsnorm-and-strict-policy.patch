 void rms_norm(const float* x, const float* w, float* y, int n, int rows, float eps, void* stream, int y_stride) {
+#ifdef STRATA_SAGE_INTEGRATION
+    // Explicitly enabled experiment; preserve the original path by default. The
+    // first candidate covers Sage's 2048-wide main norms, using caller memory.
+    const char* backend = std::getenv("STRATA_SAGE_RMSNORM");
+    if (backend && std::string(backend) == "1" && n == 2048 && x != y && w != y &&
+        sage::cuda::try_rms_norm_f32(x, w, y, n, rows, eps, stream, y_stride ? y_stride : n))
+        return;
+#endif
     rms_norm_kernel<<<rows, sum_threads(n), 0, cs(stream)>>>(x, w, y, n, eps, y_stride ? y_stride : n);
     if (const cudaError_t e = cudaGetLastError(); e != cudaSuccess)
         throw std::runtime_error(std::string("rms_norm: ") + cudaGetErrorString(e));
